# ===== Sonar Reply: copie para .env e preencha =====
# NUNCA envie este arquivo (.env) para o GitHub nem cole seus valores em chats.

# --- Seguranca do painel (obrigatorio) ---
ADMIN_PASSWORD=troque-por-uma-senha-forte

# --- Modos de seguranca ---
# DRY_RUN=true  -> nao chama a Meta; apenas simula e registra (use para testar)
DRY_RUN=true
# APPROVAL_MODE=true -> nada e publicado sem voce aprovar no painel
APPROVAL_MODE=true
# Maximo de comentarios respondidos por hora (protecao anti-spam)
MAX_REPLIES_PER_HOUR=30
# Dias sem reenviar a DM do grupo para a mesma pessoa (0 = desligado; use um número alto, como 3650, para nunca repetir)
DM_COOLDOWN_DAYS=30
# Lê a legenda do post comentado para a IA responder com contexto (true/false)
POST_CONTEXT=true

# --- Meta / Instagram ---
META_VERIFY_TOKEN=invente-um-texto-secreto-qualquer
META_APP_SECRET=
IG_ACCOUNT_ID=
IG_ACCESS_TOKEN=
GRAPH_BASE=https://graph.instagram.com
GRAPH_VERSION=v23.0

# --- Grupo ---
GROUP_LINK=https://exemplo.com/seu-grupo

# --- IA (qualquer API compativel com o formato OpenAI /chat/completions) ---
# Groq (gratuito): https://api.groq.com/openai/v1
AI_BASE_URL=https://api.groq.com/openai/v1
AI_API_KEY=
AI_MODEL=openai/gpt-oss-120b

# --- Arquivos ---
DB_PATH=data/sonar.db
RULES_FILE=rules.yaml
